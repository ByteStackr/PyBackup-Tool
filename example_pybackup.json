{
    "_comment": "Example .pybackup.json. Keys starting with an underscore are ignored.",

    "backup_name": "FullStack WebApp Backup",
    "project_name": "webapp",
    "source_paths": ["."],
    "destination": "../backups/webapp",
    "filename_format": "{YYYY-MM-DD}_{project_name}_v{SrNo}_{branch}",
    "archive_format": "tar.gz",
    "compression_level": 6,

    "_include_comment": "A name without a slash matches at any depth. Use ['*'] to take everything.",
    "include_patterns": [
        "src/",
        "public/",
        "config/",
        "docs/",
        "tests/",
        "scripts/",
        "*.{py,js,jsx,ts,tsx}",
        "*.{html,css,scss}",
        "*.{json,yaml,yml,toml}",
        "*.{md,txt,sql,sh,bat,ps1}",
        "Dockerfile",
        "docker-compose.*",
        "Makefile",
        "LICENSE*",
        ".gitignore",
        ".env.example"
    ],

    "_exclude_comment": "Excludes win over includes. A later '!pattern' re-includes a file.",
    "exclude_patterns": [
        ".git/",
        ".svn/",
        ".hg/",

        "node_modules/",
        "bower_components/",
        "__pycache__/",
        "*.egg-info/",
        "*.pyc",
        "*.pyo",
        ".tox/",
        ".pytest_cache/",
        ".mypy_cache/",
        "htmlcov/",
        ".coverage",

        "build/",
        "dist/",
        "out/",
        "target/",
        ".next/",
        ".nuxt/",

        ".env",
        ".env.*",
        "!.env.example",
        "!.env.template",
        ".venv/",
        "venv/",
        "config/secrets.yml",
        "config/master.key",

        "*.log",
        "logs/",
        "*.tmp",
        "tmp/",
        "*.swp",
        "*.swo",
        "*~",
        "*.bak",

        ".vscode/*",
        "!.vscode/settings.json",
        "!.vscode/extensions.json",
        ".idea/",

        ".DS_Store",
        "Thumbs.db",
        "desktop.ini",

        "*.sqlite",
        "*.sqlite3",
        ".cache/",

        "*.{zip,rar,7z,iso}",
        "*.{mp4,avi,mkv,mov}"
    ],

    "_cleanup_comment": "Off unless enabled. The newest 'min_keep' complete backups are never deleted.",
    "auto_cleanup": {
        "enabled": true,
        "max_backups": 20,
        "max_age_days": 90,
        "min_keep": 3
    },

    "summary": {
        "default_summary": "Automated backup of {project_name}"
    }
}
